# AgenticFlow Platform Template
# Repository root is the folder containing this file.
#
# DO NOT commit actual secrets. Copy this file to .env and fill in values.
#
# AGENTICFLOW_API_KEY: your personal API key (starts with a9w_... or af_...)
# AGENTICFLOW_WORKSPACE_ID: the workspace UUID shown in browser URL or via `af bootstrap --json`
# AGENTICFLOW_PROJECT_ID: the project UUID shown in browser URL or via `af bootstrap --json`
#
# You can support multiple workspaces by using `.env.PROFILE` naming convention.

AGENTICFLOW_API_KEY=a9w_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENTICFLOW_WORKSPACE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENTICFLOW_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: suppress deprecation noise while migrating from legacy tooling
AF_SILENCE_DEPRECATIONS=0

# Optional: allow insecure TLS (only for local dev backends)
# AF_INSECURE_TLS=0
